  m_Script: {fileID: 11500000, guid: 69a9ee36389921a4dbfc4f3f907dee2d, type: 3}
  m_Name: 17. CutScreen 3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  dialogues:
  - "\uC601\uB871\uC774 \uC0C1\uD0DC\uB294 \uC0DD\uAC01\uBCF4\uB2E4 \uD6E8\uC52C
    \uB354 \uC2EC\uAC01\uD588\uB2E4."
  - "\uCF54\uC640 \uC785\uC5D0\uC11C\uB294 \uBA48\uCD94\uC9C0 \uC54A\uACE0 \uD53C\uAC00
    \uD758\uB7EC\uB098\uC654\uB2E4."
  - "\uB098\uB294 \uB5A8\uB9AC\uB294 \uC190\uC73C\uB85C \uC601\uB871\uC774\uB97C
    \uACC4\uC18D \uC4F0\uB2E4\uB4EC\uC73C\uBA70 \uB9D0\uD588\r\n\uB2E4. "
  - "\uC601\uB871\uC544\u2026. \uC9C4\uC9DC \uACE0\uB9C8\uC6CC\u2026"
  - "\uADF8\uB9AC\uACE0..."
  - "\uC0AC\uB791\uD574\u2026."
  - "\uB0B4 \uAC00\uC7A5 \uCC2C\uB780\uD588\uB358 10\uB300 \uC2DC\uC808\uC744 \uB530\uB73B\uD558\uAC8C
    \uCC44\uC6CC\uC918\uC11C, \uC815\uB9D0 \uACE0\uB9C8\uC6E0\uB2E4\uACE0. \uB208\uBB3C
    \uC11E\uC778 \uBAA9\uC18C\uB9AC\uB85C \uBA87 \uBC88\uC774\uACE0 \uADD3\uAC00\uC5D0
    \uC911\uC5BC\uAC70\uB838\uB2E4."
  - "\uADF8\uB807\uAC8C \uC624\uC804 8\uC2DC 22\uBD84 \uC601\uB871\uC774\uB294 \uD640\uB85C
    \uC544\uD508 \uC228\uC744 \uAC70\uB450\r\uACE0 \uD558\uB298\uC758 \uBCC4\uC774
    \uB418\uC5C8\uB2E4."
  - "\uAC04\uD638\uC0AC\uBD84\uB4E4\uC740 \uC601\uB871\uC774\uB97C \uC870\uC2EC\uD788
    \uB370\uB824\uAC04 \uB4A4 \uCEE4\uB2E4\uB780 \uC0C1\uC790 \uC548\uC5D0 \uC815\uC131\uAECF
    \uB2F4\uC544 \uC8FC\uC5C8\uB2E4."
  - "\uD558\uACE0 \uC2F6\uC740 \uB9D0\uC740 \uC0B0\uB354\uBBF8\uCC98\uB7FC \uC313\uC5EC
    \uC788\uB294\uB370, \uD558\uB298\uC740 \uC815\uB9D0... \uB108\uBB34\uB098 \uC794\uC778\uD588\uB2E4."
