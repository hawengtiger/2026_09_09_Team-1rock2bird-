  m_Script: {fileID: 11500000, guid: 69a9ee36389921a4dbfc4f3f907dee2d, type: 3}
  m_Name: 18. CutScreen 4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  dialogues:
  - "\uC601\uB871\uC774 \uACC1\uC5D0 \uB354 \uBA38\uBB3C\uACE0 \uC2F6\uC5C8\uC73C\uB098,
    \uBB34\uB354\uC6B4 \uC5EC\uB984\uB0A0\uC774\uC5C8\uB2E4."
  - "\uC2AC\uD514\uC744 \uCD94\uC2A4\uB9B4 \uACA8\uB97C \uC870\uCC28 \uC8FC\uC9C0
    \uC54A\uC740 \uCC44, \uC601\uB871\uC774\uB97C \uD488\uC5D0 \uC548\uACE0 \uACE7\uBC14\uB85C
    \uC7A5\uB840\uC2DD\uC7A5\uC73C\uB85C \uD5A5\uD588\uB2E4."
  - "\uC7A5\uB840\uC2DD\uC7A5\uC5D0 \uB3C4\uCC29\uD574 \uD544\uC694\uD55C \uC808\uCC28\uC640
    \uC0C1\uB2F4\uC744 \uB9C8\uCE58\uACE0, \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC601\uB871\uC774\uB97C
    \uD488\uC5D0 \uC548\uC544 \uBCF4\uC558\uB2E4."
  - "\uBCD1\uC6D0\uC5D0 \uC788\uC744\uB54C\uB9CC \uD574\uB3C4 \uB530\uB73B\uD588\uC5C8\uB294\uB370...
    \uC9C0\uAE08 \uC601\uB871\uC774 \uBAB8\uC740 \uCC28\uAC11\uAC8C \uAD73\uC5B4
    \uC788\uC5C8\uB2E4."
  - "\uC0AC\uD6C4\uACBD\uC9C1\uC774 \uCC3E\uC544\uC628 \uC791\uC740 \uBAB8\uC740
    \uB108\uBB34\uB098 \uB531\uB531\uD574\uC838\uC11C, \uC81C\uB300\uB85C \uC548\uC544\uC8FC\uAE30
    \uD798\uB4E4\uC5C8\uB2E4."
  - "\uAD73\uC5B4\uBC84\uB9B0 \uBAB8\uC744 \uB290\uB080 \uC21C\uAC04, \uCC38\uC558\uB358
    \uB208\uBB3C\uC774 \uD130\uC84C\uB2E4."
  - "\uC774\uC81C \uC815\uB9D0\uB85C \uC601\uB871\uC774\uAC00 \uB3CC\uC544\uC62C
    \uC218 \uC5C6\uB2E4\uB294\uAC78..."
  - "\uC774\uBCC4\uC774 \uC2E4\uAC10 \uB098\uAE30 \uC2DC\uC791\uD588\uB2E4."
  dialogueSettings:
  - dialogueType: 1
