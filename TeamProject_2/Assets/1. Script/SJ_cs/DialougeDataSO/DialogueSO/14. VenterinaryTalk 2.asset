  m_Script: {fileID: 11500000, guid: 69a9ee36389921a4dbfc4f3f907dee2d, type: 3}
  m_Name: 14. VenterinaryTalk 2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  dialogues:
  - "\uC544.. \uBCF4\uD638\uC790\uB2D8 \uC624\uC168\uC5B4\uC694...? "
  - "...\uC601\uB871\uC774\uB294\uC694? \uC601\uB871\uC774\uB294 \uC5B4\uB514\uC788\uC5B4\uC694..?"
  - "\uC9C0\uAE08 \uC0C1\uD0DC\uAC00 \uB108\uBB34 \uC548 \uC88B\uC2B5\uB2C8\uB2E4.
    \uC601\uB871\uC774\uAC00 \uD53C\uB97C \uD1A0\uD574\uC11C\uC694."
  - "...\uD639\uC2DC... \uB354 \uC774\uC0C1 \uCE58\uB8CC\uAC00 \uC758\uBBF8\uAC00
    \uC5C6\uC744\uC815\uB3C4\uB85C, \uB098\uC05C\uAC00\uC694?"
  - "\uB124, \uC9C0\uAE08\uC73C\uB85C\uC120 \uCE58\uB8CC\uBCF4\uB2E4... \uBCF4\uD638\uC790\uC2E4\uC5D0\uC11C
    \uACC1\uC744 \uC9C0\uCF1C\uC8FC\uC2DC\uB294\uAC8C \uC88B\uC744 \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - .........
  - "\uC800\uD76C \uCE21\uB3C4 \uCD5C\uC120\uC744 \uB2E4\uD588\uC73C\uB098, \uC88B\uC740\uACB0\uACFC\uB97C
    \uB9D0\uC500\uB4DC\uB9AC\uC9C0 \uBABB\uD574, \uC8C4\uC1A1\uD569\uB2C8\uB2E4..."
  - .........
  - "\uADF8\uB7FC, \uBCF4\uD638\uC790\uC2E4\uB85C \uC548\uB0B4\uD574 \uB4DC\uB9B4\uAC8C\uC694."
  - .........
