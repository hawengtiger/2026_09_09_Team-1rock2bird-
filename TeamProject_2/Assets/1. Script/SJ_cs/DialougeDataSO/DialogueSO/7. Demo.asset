  m_Name: 7. Demo
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  dialogues:
  - "\uC544! \uB9DE\uB2E4 \uAE4C\uBA39\uACE0 \uC788\uC5C8\uB294\uB370,"
  - "\uD50C\uB808\uC774\uC5B4\uD55C\uD14C \uB9D0\uD558\uC9C0 \uBABB\uD55C\uAC8C \uD558\uB098
    \uC788\uC5C8\uC5B4\uC694."
  - "\uC544\uC27D\uAC8C\uB3C4 \uC774 \uAC8C\uC784\uC774 \uBBF8\uC644\uC131\uC774\uB77C\uACE0
    \uD558\uB124\uC694."
  - "\uADF8\uB7FC \uC5B4\uB514\uAE4C\uC9C0 \uB9CC\uB4E4\uC5C8\uB0D0\uACE0\uC694?"
  - "\uC9C0\uAE08 \uC5EC\uAE30\uAE4C\uC9C0\uC694~! "
  - "[\uAC1C\uBC1C\uC790]\uAC00 \uC804\uD574 \uB2EC\uB798\uC694 \uADF8\uB7FC \uC774\uB9CC."
