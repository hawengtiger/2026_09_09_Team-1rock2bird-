  m_Script: {fileID: 11500000, guid: 69a9ee36389921a4dbfc4f3f907dee2d, type: 3}
  m_Name: 13. CutScreen1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueDataSO
  dialogues:
  - "\uADF8\uB807\uAC8C \uC0C8\uBCBD 3\uC2DC, \uAC11\uC791\uC2A4\uB7FD\uAC8C  \uC785\uC6D0\uD588\uB2E4."
  - "\uC804\uC5D0\uB3C4 \uD3D0\uC218\uC885\uC744 \uBB34\uC0AC\uD788 \uACAC\uB38C\uB0B4
    \uC900 \uB140\uC11D\uC774\uC5C8\uAE30\uC5D0,\n\uC774\uBC88\uC5D0\uB3C4 \uB2F9\uC5F0\uD788
    \uBC84\uD168\uC904 \uAC70\uB77C \uBBFF\uC5C8\uB2E4."
  - "\uC544\uB2C8, \uBBFF\uC5B4\uC57C\uB9CC \uD588\uB2E4."
  - "\uC7A0\uC870\uCC28 \uC774\uB8E8\uC9C0 \uBABB\uD55C \uCC44 \uC138\uC0C1\uC758
    \uBAA8\uB4E0 \uC2E0\uC5D0\uAC8C \uBA87 \uBC88\uC774\uACE0 \uBE4C\uACE0 \uB610
    \uBE4C\uC5C8\uB2E4."
  - "\uD558\uC9C0\uB9CC \uB0B4 \uAC04\uC808\uD568\uC774 \uBD80\uC871\uD588\uB358
    \uAC78\uAE4C..?"
  - "\uC0C8\uBCBD 7\uC2DC, \uBB35\uC9C1\uD55C \uC815\uC801\uC744 \uAE6C \uBCD1\uC6D0\uC758
    \uC804\uD654."
  - "\"...\uC5EC\uBCF4\uC138\uC694?\""
  - "\"...\uC601\uB871\uC774 \uC0C1\uD0DC\uAC00 \uB108\uBB34 \uC548 \uC88B\uC2B5\uB2C8\uB2E4.
    \uC9C0\uAE08 \uBC14\uB85C \uC640\uC8FC\uC154\uC57C \uD560 \uAC83 \uAC19\uC544\uC694.\""
  - "\uB098\uB294 \uC637\uC744 \uCC59\uACA8 \uC785\uC744 \uACA8\uB97C\uB3C4 \uC5C6\uC774,
    \uBBF8\uCE5C \uB4EF\uC774 \uBCD1\uC6D0\uC73C\uB85C \uD5A5\uD588\uB2E4."
